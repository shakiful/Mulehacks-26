# Copy to backend/.env; run commands from the repository root.
# Root .env (when present) and process environment override this file.
DEMO_MODE=true
DATABASE_URL=sqlite:///./backend/connecthub.db
CORS_ORIGINS=http://localhost:5173
# Optional ISO date; defaults to today in DEMO_TIMEZONE for new seed posts.
DEMO_DATE=
DEMO_TIMEZONE=America/Chicago
# Offline extraction and matching are explicitly labeled HEURISTIC.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=30
AI_FALLBACK_ENABLED=true
# Matching can use OpenAI embeddings while understanding stays heuristic.
EMBEDDING_PROVIDER=gemini
OPENAI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_SECONDS=10
# Google option: set AI_PROVIDER=gemini and EMBEDDING_PROVIDER=gemini,
# EMBEDDING_MODEL=gemini-embedding-001, EMBEDDING_DIMENSIONS=768.
# Use a server-only Gemini API key; GOOGLE_API_KEY is also accepted.
GEMINI_API_KEY=AQ.Ab8RN6IpZRPrOyzSaFnS7CYGCnNQQbrTNNJpbcvXbYoRc2piuA
