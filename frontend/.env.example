# Live backend is the default; set true for synthetic offline fixture mode.
# Only public settings belong here. Gemini keys stay on the backend.
VITE_USE_MOCKS=false
VITE_API_BASE_URL=http://localhost:8000/api
# Optional public, origin-restricted MapTiler key. Blank uses OpenFreeMap.
# MapTiler load/auth/quota failures fall back to OpenFreeMap. Never use the Gemini key here.
VITE_MAPTILER_API_KEY=
