# Backend reads root .env after implementation. Set these independently per laptop.
DEMO_MODE=true
DATABASE_URL=sqlite:///./backend/connecthub.db
CORS_ORIGINS=http://localhost:5173
AI_PROVIDER=gemini
AI_FALLBACK_ENABLED=true
OPENAI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
DEMO_DATE=
DEMO_TIMEZONE=America/Chicago
# Frontend: create frontend/.env.local containing:
# VITE_API_BASE_URL=http://localhost:8000/api
# VITE_USE_MOCKS=false
# Never put API credentials in a VITE variable.
